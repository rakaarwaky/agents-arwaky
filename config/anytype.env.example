# ==============================================================================
# agents-arwaky Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
#
# DO NOT commit your actual .env file with private keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Anytype Headless Daemon & MCP Configuration
# ------------------------------------------------------------------------------
# Default API endpoint exposed by anytype-cli (headless daemon):
# Default port for CLI is 31012 (Anytype Desktop GUI uses 31009).
ANYTYPE_API_BASE_URL=http://127.0.0.1:31012

# Anytype API key (Bearer token).
# Generate this using: arwaky anytype auth-key "mcp-bot"
# Or: ./tools/anytype-daemon/anytype-daemon.sh auth-key "mcp-bot"
ANYTYPE_API_KEY=

# Anytype Daemon Container Name (when running via Podman)
ANYTYPE_CONTAINER_NAME=anytype-daemon

# Anytype Bot Account Name
ANYTYPE_BOT_NAME=arwaky-agent
