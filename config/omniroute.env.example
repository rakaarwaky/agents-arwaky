# ==============================================================================
# OmniRoute — environment template
# ==============================================================================
# Copy and fill in:
#   cp config/omniroute.env.example config/omniroute.env
#
# `aa tool install omniroute` copies config/omniroute.env to
#   ~/.omniroute/.env
# which is where OmniRoute actually reads it — upstream loads `.env` from its own
# working directory, not from ~/.config/<tool>/.
#
# An existing ~/.omniroute/.env is NEVER overwritten. STORAGE_ENCRYPTION_KEY
# decrypts every provider credential in storage.sqlite; regenerating it leaves the
# whole database unreadable while still looking healthy.
#
# To apply your edits:
#   install -m 600 config/omniroute.env ~/.omniroute/.env
#   aa omniroute restart
# ==============================================================================

# Encrypts stored provider credentials. Required, and must stay stable once
# credentials exist. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
STORAGE_ENCRYPTION_KEY="change-me-64-hex-chars"

# Serve port. Upstream defaults to 20128; this ecosystem standardises 7777.
# ecosystem. Override with OMNIROUTE_PORT, or edit PORT here and restart.
PORT=7777

# ------------------------------------------------------------------------------
# Throughput / timeout tuning
# ------------------------------------------------------------------------------
# Raise these for long or heavy requests (large contexts, slow providers).

# Queue this long for a rate-limited slot before giving up.
RATE_LIMIT_MAX_WAIT_MS=180000
RATE_LIMIT_MAX_QUEUE_DEPTH=0

# Per-request fetch/header timeouts.
OMNIROUTE_DIRECT_HEADERS_TIMEOUT_MS=180000
OMNIROUTE_DEFAULT_FETCH_TIMEOUT_MS=180000
FETCH_TIMEOUT_MS=180000

# How many heavy requests may run at once, and how long a queued one waits
# before being shed instead.
OMNIROUTE_CHAT_MAX_HEAVY_IN_FLIGHT=10
OMNIROUTE_CHAT_ADMISSION_QUEUE_MS=120000
OMNIROUTE_CHAT_HEAVY_MESSAGE_COUNT=500
OMNIROUTE_CHAT_HEAVY_ESTIMATED_TOKENS=200000

# ------------------------------------------------------------------------------
# Provider credentials — usually not needed here
# ------------------------------------------------------------------------------
# OmniRoute reaches most providers with no key at all; its free-tier catalogue is
# what makes the gateway useful out of the box. Keys are better added through
# `omniroute setup` or the dashboard, which store them in storage.sqlite rather
# than in this file.
#
# OPENROUTER_API_KEY=""
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
