# ==============================================================================
# OmniRoute Environment Configuration
# ==============================================================================
# Port for OmniRoute Web Dashboard & OpenAI-compatible REST API
OMNIROUTE_PORT=7777

# Initial Admin Dashboard Password
# If set, OmniRoute will require this password for dashboard login.
INITIAL_PASSWORD=""

# OmniRoute Consumer API Key for Agents / Antigravity
OMNIROUTE_KEY="sk-your-omniroute-consumer-key-here"
