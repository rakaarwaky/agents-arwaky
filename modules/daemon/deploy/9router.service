[Unit]
Description=9Router AI Gateway (host-native)
Documentation=https://github.com/decolua/9router
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=%h
Environment=PORT=20128
Environment=HOSTNAME=0.0.0.0
Environment=NODE_ENV=production
Environment=PATH=%h/.local/share/nodejs/node-v24.11.0-linux-x64/bin:%h/.local/bin:/usr/local/bin:/usr/bin
EnvironmentFile=-%h/.config/agents-arwaky/ninerouter.env
WorkingDirectory=%h/.9router
ExecStart=/usr/bin/env 9router --port 20128 --no-browser --skip-update
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
