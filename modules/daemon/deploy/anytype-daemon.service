[Unit]
Description=Anytype Headless Daemon (container)
After=network-online.target
Wants=network-online.target
# Wajib untuk Restart=always. Default systemd (5 start / 10 dtk) membuat unit
# latch ke `failed` permanen kalau container crash-loop, dan tidak pernah
# mencoba start lagi — harus `systemctl --user reset-failed` manual.
# Longgarkan supaya container yang lambat boot tetap sempat pulih.
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
Environment=ANYTYPE_IMAGE=localhost/anytype-daemon:latest
ExecStartPre=-/usr/bin/podman stop anytype-daemon
ExecStartPre=-/usr/bin/podman rm anytype-daemon
ExecStart=/usr/bin/podman run --rm --name anytype-daemon \
  --network=host \
  -v %h/.local/share/anytype-mcp:/data:Z \
  -v %h/.local/share/anytype:/root/.anytype:Z \
  ${ANYTYPE_IMAGE}
ExecStop=/usr/bin/podman stop -t 10 anytype-daemon
Restart=always
RestartSec=5s
# Beri waktu anytype menyelesaikan sync sebelum container dibunuh.
TimeoutStopSec=30

[Install]
WantedBy=default.target
