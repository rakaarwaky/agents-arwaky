[Unit]
Description=OmniRoute AI Gateway (host-native, no container)
After=network-online.target
Wants=network-online.target
# Wajib untuk Restart=always: rate-limit harus benar-benar dimatikan, bukan
# hanya dilonggarkan. Config lama (Burst=20 / Interval=300 dtk) TETAP latch ke
# `failed`: 20 x RestartSec=5s = 100 dtk < 300 dtk, jadi limit selalu tercapai
# sebelum jendela habis, lalu unit berhenti mencoba sampai `reset-failed` manual.
# Interval=0 menonaktifkan StartLimit sepenuhnya, sehingga Retry=always benar-
# benar selalu retry dan unit pulih sendiri begitu penyebab kegagalan hilang
# (mis. koneksi lama yang masih menempel di port sudah ditutup).
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=HOME=%h
Environment=NODE_ENV=production
Environment=PATH=%h/.local/share/nodejs/node-v24.11.0-linux-x64/bin:%h/.local/bin:/usr/local/bin:/usr/bin
# OmniRoute reads its own .env from the working directory below; that file holds
# STORAGE_ENCRYPTION_KEY, which decrypts every provider credential in
# storage.sqlite. The daemon code never rewrites it.
EnvironmentFile=-%h/.omniroute/.env
WorkingDirectory=%h/.omniroute
ExecStart=@@EXEC_BINARY@@ serve --port @@PORT@@ --no-open --no-tray
Restart=always
RestartSec=5s
TimeoutStopSec=30
# Backstop tylko, bukan tuning harian. Insiden 2026-10-17: server accept TCP di
# 7777 tapi tidak pernah jawab HTTP (health timeout, dashboard "Reconnecting…")
# sementara main thread 100% CPU dan RSS naik tanpa batas. Type=simple tidak
# punya deteksi hang, jadi MemoryHigh (tekanan soft, tidak membunuh) +
# MemoryMax (bunuh proses) memastikan runaway tidak sampai OOM-kill seluruh host.
# Nilai longgar karena pemakaian normal setelah storage.sqlite di-prune ke
# window retensinya ada di ~150-250 MB; menyentuh 3G berarti leak, bukan beban
# normal.
MemoryHigh=1500M
MemoryMax=3G

[Install]
WantedBy=default.target
