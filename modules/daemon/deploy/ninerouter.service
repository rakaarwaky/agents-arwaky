[Unit]
Description=9Router AI Gateway (container)
Documentation=https://github.com/decolua/9router
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=NINEROUTER_IMAGE=ghcr.io/decolua/9router:latest
Environment=NINEROUTER_PORT=20128
Environment=INITIAL_PASSWORD=
EnvironmentFile=-%h/agents-arwaky/tools/config/ninerouter.env
ExecStartPre=-/usr/bin/podman stop 9router
ExecStartPre=-/usr/bin/podman rm 9router
ExecStart=/usr/bin/podman run --rm --name 9router \
  --network=host \
  --dns 192.168.1.1 \
  -v /etc/resolv.conf:/etc/resolv.conf:ro \
  -v %h/.local/share/9router/data:/app/data:Z \
  -e DATA_DIR=/app/data \
  -e PORT=20128 \
  -e HOSTNAME=0.0.0.0 \
  -e NODE_OPTIONS="--dns-result-order=ipv4first" \
  -e INITIAL_PASSWORD=${INITIAL_PASSWORD} \
  ghcr.io/decolua/9router:latest
ExecStop=/usr/bin/podman stop -t 10 9router
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
