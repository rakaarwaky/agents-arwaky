# Anytype headless daemon container image
# Build: podman build -t localhost/anytype-daemon:latest .
FROM node:20-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Install Anytype headless
RUN curl -fsSL https://github.com/anyproto/anytype-ts/releases/latest/download/anytype-headless-linux-amd64.tar.gz | \
    tar xz -C /usr/local/bin/

# Install bun for MCP server
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"

WORKDIR /app
EXPOSE 31012

ENTRYPOINT ["anytype"]
CMD ["daemon"]
