{
  "mcpServers": {
    "fetch": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-fetch-server"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "desktop-commander": {
      "command": "npx",
      "args": [
        "-y",
        "@wonderwhy-er/desktop-commander"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_PERSONAL_ACCESS_TOKEN"
      }
    },
    "blender-mcp": {
      "command": "uvx",
      "args": [
        "blender-mcp"
      ]
    },
    "gmail": {
      "command": "npx",
      "args": [
        "-y",
        "gmail-mcp-server"
      ]
    },
    "arwaky-mail": {
      "command": "npx",
      "args": [
        "-y",
        "arwaky-mail"
      ]
    },
    "arwaky-test": {
      "command": "uvx",
      "args": [
        "arwaky-test"
      ]
    },
    "arwaky-lint": {
      "command": "uvx",
      "args": [
        "arwaky-lint"
      ]
    },
    "arwaky-vision": {
      "command": "uvx",
      "args": [
        "arwaky-vision"
      ]
    }
  }
}