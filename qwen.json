{
  "mcpServers": {
    "fetch": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-fetch-server"
      ]
    },
    "contex7-arwaky": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "comander-arwaky": {
      "command": "npx",
      "args": [
        "-y",
        "@wonderwhy-er/comander-arwaky"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_PERSONAL_ACCESS_TOKEN"
      }
    },
    "blender-arwaky": {
      "command": "uvx",
      "args": [
        "blender-arwaky"
      ]
    },
    "gmail": {
      "command": "npx",
      "args": [
        "-y",
        "gmail-arwaky-server"
      ]
    },
    "arwaky-mail": {
      "command": "npx",
      "args": [
        "-y",
        "arwaky-mail"
      ]
    },
    "arwaky-test": {
      "command": "uvx",
      "args": [
        "arwaky-test"
      ]
    },
    "arwaky-lint": {
      "command": "uvx",
      "args": [
        "arwaky-lint"
      ]
    },
    "vision-arwaky": {
      "command": "uvx",
      "args": [
        "vision-arwaky"
      ]
    }
  }
}