# BlenderMCP — Environment Variable API Key Configuration
# Copy this file to .env.blendermcp (or set these in your shell) before starting Blender.
# Source with: export $(cat .env.blendermcp | xargs)  # or use direnv/dotenv

# ─── Sketchfab ────────────────────────────────────────────────────────────────────
# Get from: https://sketchfab.com/settings/api
# Used by: search_sketchfab_models, download_sketchfab_model, etc.
BLENDERMCP_SKETCHFAB_API_KEY=your_sketchfab_api_token_here

# ─── Hyper3D (Rodin) ────────────────────────────────────────────────────────────
# Get from: https://hyper3d.ai/ or https://fal.ai/ (choose platform in UI)
# Used by: generate_hyper3d_model_via_text, generate_hyper3d_model_via_images
BLENDERMCP_HYPER3D_API_KEY=your_hyper3d_api_key_here

# ─── Hunyuan3D (Tencent) ────────────────────────────────────────────────────────
# For OFFICIAL_API mode: obtain SecretId/SecretKey from Tencent Cloud
# For LOCAL_API mode: set the API URL of your self-hosted Hunyuan service
# Used by: generate_hunyuan3d_model, poll_hunyuan_job_status

# Official API (requires both):
BLENDERMCP_HUNYUAN3D_SECRET_ID=your_hunyuan_secret_id
BLENDERMCP_HUNYUAN3D_SECRET_KEY=your_hunyuan_secret_key

# Local API (optional, defaults to http://localhost:8081):
BLENDERMCP_HUNYUAN3D_API_URL=http://localhost:8081

# ─── Optional: Blender Socket Configuration ────────────────────────────────────
# Defaults: localhost:9876
# BLENDER_HOST=localhost
# BLENDER_PORT=9876
