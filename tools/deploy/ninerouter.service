[Unit]
Description=9Router AI Gateway (container)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=NINEROUTER_IMAGE=ghcr.io/decolua/9router:latest
Environment=NINEROUTER_PORT=20128
ExecStartPre=-/usr/bin/podman rm -f 9router
ExecStart=/usr/bin/podman run --rm --name 9router \
  -p 20128:20128 \
  -v %h/.local/share/9router/data:/app/data:Z \
  -e DATA_DIR=/app/data \
  -e PORT=20128 \
  -e HOSTNAME=0.0.0.0 \
  --env-file %h/.config/agents-arwaky/ninerouter.env \
  --restart unless-stopped \
  ${NINEROUTER_IMAGE}
ExecStop=/usr/bin/podman stop 9router
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
