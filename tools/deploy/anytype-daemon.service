[Unit]
Description=Anytype Headless Daemon (container)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=ANYTYPE_IMAGE=localhost/anytype-daemon:latest
ExecStartPre=-/usr/bin/podman stop anytype-daemon
ExecStartPre=-/usr/bin/podman rm anytype-daemon
ExecStart=/usr/bin/podman run --rm --name anytype-daemon \
  --network=host \
  -v %h/.local/share/anytype-mcp:/data:Z \
  -v %h/.local/share/anytype:/root/.anytype:Z \
  ${ANYTYPE_IMAGE}
ExecStop=/usr/bin/podman stop -t 10 anytype-daemon
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
