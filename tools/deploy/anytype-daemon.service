[Unit]
Description=Anytype Headless Daemon (container)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=ANYTYPE_IMAGE=localhost/anytype-daemon:latest
ExecStartPre=-/usr/bin/podman rm -f anytype-daemon
ExecStart=/usr/bin/podman run --rm --name anytype-daemon \
  --network host \
  -v %h/.local/share/anytype-mcp:/data:Z \
  -v %h/.local/share/anytype:/root/.anytype:Z \
  --restart unless-stopped \
  ${ANYTYPE_IMAGE}
ExecStop=/usr/bin/podman stop anytype-daemon
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
