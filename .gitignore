# Cache directories
.mypy_cache/
.pytest_cache/
.ruff_cache/
.uv-cache/
.vscode/

# CodeGraph index — local code intelligence, rebuilt per project with `codegraph init`.
# Unanchored on purpose: submodules carry their own .codegraph/ at their roots.
.codegraph/

# Python virtual environments & build artifacts
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
/build/
dist/
*.egg-info/
.coverage
htmlcov/

# Node.js
node_modules/
tools/*/node_modules/
tools/*/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Generated MCP configurations
mcp_servers.generated.json
*.local.generated.json

# Tool build artifacts
tools/ponytail/hooks/
tools/ponytail/skills/
tools/ponytail/package.json
tools/context7/package.json
tools/anytype-mcp/daemon/anytype

# Environment and local configs
.env
.env.*
.dev.vars
config/*/env
config/*/.env
config/ninerouter.providers.json
config/ninerouter.env
config/anytype.env

# Windows OS files
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Log files
*.log

# Large Model Files
# Keep the extension global (that's what actually carries weight); the bare
# `models/` form silently swallowed any source directory named models anywhere
# in the tree, so the scratch-dir rule is anchored to the repo root.
*.gguf
/models/

# Agents
.qwen
.commandcode/
.qwen-web/
.agents/plans/
# Ignore vscode AI rules
.github/instructions/codacy.instructions.md

# Never commit live credentials (real secrets live in $XDG_DATA_HOME/agents-arwaky/config/)
tools/config/*.env
!tools/config/*.env.example
tools/config/*.providers.json
!tools/config/*.providers.example.json

# Codacy review artifacts
.codacy/

# Large binary: diunduh saat install, bukan di-commit
**/anytype-bin

# Harness runtime state — the harness skills root is symlinked to ./skills,
# so these live next to the pack but must never enter git.
/skills/.hub/
/skills/.usage.json
/skills/.usage.json.lock
/skills/.curator_backups/
/skills/.curator_ledger.jsonl
/skills/.curator_state
/skills/.bundled_manifest
/skills/skills-lock.json

# A harness run with HOME pointed inside a skill dir leaves `<skill>/.hermes/skills`
# behind — a link back to this same pack, so the loader sees recursive phantom skills.
/skills/**/.hermes/
/skills/**/.qwen/
/skills/**/.codex/

# Loader alias-indexes: harness loaders index underscore names from the hyphen
# pack dirs THROUGH the harness root link (anytype-mcp -> anytype_mcp). Generated
# noise, regenerates locally; the hyphen dir is the tracked canonical.
/skills/*_*/
.worktrees/
