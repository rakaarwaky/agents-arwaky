{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
     "contex7-arwaky": {
       "type": "local",
       "command": [
         "node",
         "C:/Users/Administrator/mcp-arwaky/contex7-arwaky/packages/mcp/dist/index.js"
       ],
       "enabled": true
     },
     "comander-arwaky": {
       "type": "local",
       "command": [
         "node",
         "C:/Users/Administrator/mcp-arwaky/comander-arwaky/dist/index.js"
       ],
       "enabled": true
     },
    "github": {
      "type": "local",
      "command": [
        "C:/Users/Administrator/mcp-arwaky/github-arwaky/github-mcp-server.exe",
        "stdio",
        "--tools",
        "github_list_activity,github_understand_codebase,github_execute_workflow,github_manage_thread,get_me,search_repositories,search_code,get_file_contents,delete_file,push_files,issue_write,add_issue_comment,pull_request_read,merge_pull_request,create_branch,list_branches,list_commits,create_repository"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_PERSONAL_ACCESS_TOKEN"
      },
      "enabled": true
    },
    "testing-arwaky": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "C:/Users/Administrator/mcp-arwaky/agentic-testing",
        "run",
        "testing-arwaky"
      ],
      "enabled": true
    },
    "lint-arwaky": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "C:/Users/Administrator/mcp-arwaky/auto-linter",
        "run",
        "lint-arwaky"
      ],
      "environment": {
        "DESKTOP_COMMANDER_URL": "127.0.0.1:4444",
        "PHANTOM_ROOT": "C:/Users/Administrator/"
      },
      "enabled": true
    },
     "fetch": {
       "type": "local",
       "command": [
         "node",
         "C:/Users/Administrator/mcp-arwaky/fetch-arwaky/dist/index.js"
       ],
       "enabled": true
     },
    "blender-arwaky": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "C:/Users/Administrator/mcp-arwaky/blender-arwaky",
        "run",
        "blender-arwaky"
      ],
      "enabled": true
    },
     "cloudmail-arwaky": {
       "type": "local",
       "command": [
         "node",
         "C:/Users/Administrator/mcp-arwaky/cloudmail-arwaky/mcp_server.js"
       ],
       "enabled": true
     },
     "gmail-arwaky": {
       "type": "local",
       "command": [
         "node",
         "C:/Users/Administrator/mcp-arwaky/gmail-arwaky/dist/index.js"
       ],
       "enabled": true
     },
    "vision-arwaky": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "C:/Users/Administrator/mcp-arwaky/vision-arwaky",
        "run",
        "vision-arwaky"
      ],
      "enabled": true
    }
  }
}
