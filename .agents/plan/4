```python
"""Tool installer/uninstaller resolution — capabilities layer."""
from __future__ import annotations
import shutil
from pathlib import Path

from manifest import Tool
from xdg import bin_home, config_home, data_home


def find_installer(tool: Tool, repo_root: Path) -> Path | None:
    overrides = {"workspace": "google-workspace-mcp", "fetch": "fetch-mcp", "anytype": "anytype-mcp"}
    names = []
    if tool.id in overrides:
        names.append(overrides[tool.id])
    names.append(tool.id)
    names.append(f"{tool.id}-mcp")
    for n in names:
        candidate = repo_root / "tools/install" / f"install_{n.replace('-', '_')}.py"
        if candidate.exists():
            return candidate
    return None


def find_uninstaller(tool: Tool, repo_root: Path) -> Path | None:
    overrides = {"workspace": "google-workspace-mcp", "fetch": "fetch-mcp", "anytype": "anytype-mcp"}
    names = []
    if tool.id in overrides:
        names.append(overrides[tool.id])
    names.append(tool.id)
    names.append(f"{tool.id}-mcp")
    for n in names:
        candidate = repo_root / "tools/uninstall" / f"uninstall_{n.replace('-', '_')}.py"
        if candidate.exists():
            return candidate
    return None


def executable_path(binary: str) -> Path | None:
    found = shutil.which(binary)
    if found:
        return Path(found)
    local = bin_home() / binary
    if local.exists():
        return local
    return None
