## Fixed Code

### `tools/lib/paths.py` (NEW — addresses D-1)

```python
"""Centralized path resolution with validation (replaces scattered parents[N])."""
from __future__ import annotations
from pathlib import Path

def repo_root() -> Path:
    """Resolve and validate the agents-arwaky repository root."""
    import os
    env_root = os.environ.get("AGENTS_ARWAKY_ROOT")
    if env_root:
        root = Path(env_root).resolve()
    else:
        root = Path(__file__).resolve().parents[2]

    manifest = root / "tools" / "config" / "manifest.json"
    if not manifest.exists():
        raise RuntimeError(
            f"agents-arwaky root not found at {root}. "
            f"Expected {manifest} to exist. "
            f"Set AGENTS_ARWAKY_ROOT or run from the repository."
        )
    return root
```

### `tools/daemons/anytype_daemon.py` — PID file + signal handling (addresses R-1)

```python
# Add at module level:
import atexit

PID_FILE = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "anytype-daemon.pid"

def _write_pid(pid: int) -> None:
    PID_FILE.parent.mkdir(parents=True, exist_ok=True)
    PID_FILE.write_text(str(pid), encoding="utf-8")

def _read_pid() -> int | None:
    if PID_FILE.exists():
        try:
            return int(PID_FILE.read_text().strip())
        except (ValueError, OSError):
            return None
    return None

def _cleanup_pid() -> None:
    PID_FILE.unlink(missing_ok=True)

# In cmd_start() native fallback, replace the Popen block:
    PID_FILE.parent.mkdir(parents=True, exist_ok=True)
    with log_file.open("ab") as f:
        p = subprocess.Popen(
            [str(anytype_bin), "serve", "--listen-address", f"127.0.0.1:{PORT}"],
            stdout=f, stderr=f, start_new_session=True,
        )
    _write_pid(p.pid)
    atexit.register(_cleanup_pid)
    print(f">>> Started local Anytype daemon (PID: {p.pid}). Logs: {log_file}")

# In cmd_stop(), replace pkill:
    pid = _read_pid()
    if pid:
        try:
            os.kill(pid, signal.SIGTERM)
            print(f">>> Sent SIGTERM to Anytype daemon (PID: {pid}).")
        except ProcessLookupError:
            print(">>> Anytype daemon process not found (stale PID file).")
        _cleanup_pid()
    else:
        subprocess.run(["pkill", "-f", "anytype serve"], capture_output=True)
    print(">>> Anytype daemon stopped.")
```

