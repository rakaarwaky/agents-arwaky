    if _color_override is not None:
        return _color_override
    if os.environ.get("NO_COLOR") is not None:
        return False
    if os.environ.get("FORCE_COLOR") is not None:
        return True
    return sys.stdout.isatty()

def _c(code: str) -> str:
    return f"\033[{code}m" if _color_enabled() else ""
