### `tools/backup/backup_manager.py` (E2)
```python
def cmd_backup(argv):
    tool = argv[0] if argv else "all"
    dest = argv[1] if len(argv) > 1 else ""
    tools = list(TOOL_DATA.keys()) if tool == "all" else [tool]
    rc = 0
    for t in tools:
        if backup_tool(t, dest) not in (0, None):
            rc = 1
    return rc

def cmd_restore(argv):
    if len(argv) < 2:
        print("Usage: aa restore <tool|all> <archive.tar.gz>", file=sys.stderr)
        return 1
    tool, archive = argv[0], argv[1]
    if tool == "all":
        rc = 0
        for t in TOOL_DATA:
            if restore_tool(t, archive) != 0:
                rc = 1
        return rc
    return restore_tool(tool, archive)
```

### `tools/install/install_blender.py` (D1/Q1 — same pattern for mnemosyne/qwen_web/vision/workspace)
```python
#!/usr/bin/env python3
"""blender installer (Python)."""
from __future__ import annotations
import subprocess
import sys
from pathlib import Path
ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "tools" / "lib"))
from utility_launcher_writer import write_uv_launchers  # noqa: E402

SRC_DIR = ROOT / "internal/blender-arwaky"

def run(cmd, cwd=None):
    subprocess.run(cmd, cwd=cwd, check=True)

def main() -> int:
    if not SRC_DIR.exists():
        print(f">>> Initializing submodule {SRC_DIR}...", file=sys.stderr)
        run(["git", "-C", str(ROOT), "submodule", "update", "--init", "internal/blender-arwaky"])
    print(f">>> Installing blender launchers...")
    created = write_uv_launchers("blender-arwaky", "internal/blender-arwaky",
                                 ['blender-arwaky', 'ba', 'blender-mcp'])
    for p in created:
        print(f"    -> {p}")
    print(">>> Successfully installed blender")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
```

