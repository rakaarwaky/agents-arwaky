### `tools/daemons/anytype_daemon.py` (E1)
```python
import re  # add to imports

def _extract_api_key(stdout: str) -> str:
    """Return the first token-shaped line (API key), else last non-empty line."""
    lines = [ln.strip() for ln in stdout.splitlines() if ln.strip()]
    for ln in lines:
        m = re.search(r"[A-Za-z0-9_\-\.]{20,}", ln)
        if m:
            return m.group(0)
    return lines[-1] if lines else ""

# inside cmd_auth_key, replace `api_key = result.stdout.strip()` with:
api_key = _extract_api_key(result.stdout)
if not api_key:
    print("Error: could not extract API key from daemon output.", file=sys.stderr)
    return 1
